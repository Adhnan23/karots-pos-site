{
  // A Worker that only serves the built site (no code): bun run build && bunx wrangler deploy
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "karots-suite-site",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "suite.karots.lk", "custom_domain": true }]
}
