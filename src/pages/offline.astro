---
import Base from '../layouts/Base.astro'
import Button from '../components/Button.astro'
---
<Base title="No connection — Karots Suite" description="This page isn't saved on this phone yet. The tour works without a connection." path="/offline/">
  <div class="wrap page">
    <h1>No connection right now</h1>
    <p class="lede">This page isn't saved on this phone yet. The tour is, so you can still show a shop how Karots Suite works.</p>
    <div class="actions">
      <Button href="/tour/">Open the tour</Button>
      <Button href="/" kind="ghost">Home</Button>
    </div>
  </div>
</Base>

<style>
  .page { padding-block: 4rem 5rem }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem }
</style>
