---
import '../styles/base.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  title: string
  description: string
  path: string
  ogImage?: string
  jsonLd?: object[]
}
const { title, description } = Astro.props
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#16171b" />
    <script is:inline>
      try { const t = localStorage.getItem('ks-site-theme'); if (t) document.documentElement.dataset.theme = t } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the page</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -999px; top: 0.5rem; z-index: 20; padding: 0.6rem 1rem; background-color: var(--saffron); color: var(--saffron-ink); border-radius: var(--r-btn) }
  .skip:focus { left: 0.5rem }
</style>
