---
import '../styles/base.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

import { DEFAULT_OG, ogPath } from '../lib/og'

interface Props {
  title: string
  description: string
  path: string
  /** The screenshot the share image is drawn from (src/lib/og.ts lists the allowed ones). */
  ogShot?: string
  jsonLd?: object[]
}
const { title, description, path, ogShot = DEFAULT_OG, jsonLd = [] } = Astro.props
const canonical = new URL(path, Astro.site).href
const og = new URL(ogPath(ogShot), Astro.site).href
const is404 = path === '/404/'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {is404 ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Karots Suite" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={og} />
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <meta name="theme-color" content="#16171b" />
    <script is:inline>
      try { const t = localStorage.getItem('ks-site-theme'); if (t) document.documentElement.dataset.theme = t } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to the page</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: -999px; top: 0.5rem; z-index: 20; padding: 0.6rem 1rem; background-color: var(--saffron); color: var(--saffron-ink); border-radius: var(--r-btn) }
  .skip:focus { left: 0.5rem }
</style>
