---
// The sale, played as frames: one picture at a time with its caption, tap to pause.
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
interface Props { frames: { src: ImageMetadata; caption: string }[]; ms?: number; label: string }
const { frames, ms = 1600, label } = Astro.props
---
<figure class="book" data-flipbook data-ms={ms} aria-label={label}>
  <div class="stage" data-stage>
    {frames.map((f, i) => (
      <Image data-frame class:list={['frame', { on: i === 0 }]} src={f.src} alt={`${label}, step ${i + 1} of ${frames.length}`} widths={[480, 720, 1024]} quality={70} sizes="(max-width: 1000px) 100vw, 980px" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} />
    ))}
  </div>
  <p class="turn">Turn your phone sideways to see it bigger.</p>
  <figcaption>
    <div class="bar">
      <button type="button" class="toggle" data-toggle data-playing="false" aria-label="Play the sale">
        <svg class="play" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M7 4.5v15l13-7.5z" /></svg>
        <svg class="pause" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="currentColor" d="M6 4h4.5v16H6zm7.5 0H18v16h-4.5z" /></svg>
      </button>
      <ol class="dots">
        {frames.map((f, i) => <li><button type="button" data-dot aria-current={i === 0 ? 'true' : 'false'} aria-label={`Step ${i + 1}: ${f.caption}`}></button></li>)}
      </ol>
    </div>
    {frames.map((f, i) => <p data-cap hidden={i !== 0}>{f.caption}</p>)}
  </figcaption>
</figure>

<script>
  import { initFlipbooks } from '../scripts/flipbook'
  initFlipbooks()
</script>

<style>
  .book { margin: 0 auto; max-width: 980px }
  .stage { display: grid; padding: 5px; border-radius: var(--r-frame); background-color: #2b2d33; box-shadow: var(--shadow); cursor: pointer }
  .stage :global(.frame) { grid-area: 1 / 1; width: 100%; height: auto; border-radius: calc(var(--r-frame) - 5px); opacity: 0; transition: opacity 0.25s ease }
  .stage :global(.frame.on) { opacity: 1 }
  /* An upright phone shows the whole till screen; turning it sideways makes it bigger. */
  .turn { display: none; margin: 0.5rem 0 0; color: var(--muted); font-size: 0.95rem }
  @media (orientation: portrait) and (max-width: 699px) { .turn { display: block } }
  /* A phone on its side: the frame fits the screen's height, with its controls just below. */
  @media (orientation: landscape) and (max-height: 500px) {
    .book { max-width: min(980px, calc((100svh - 130px) * 1.78)) }
    figcaption p { min-height: 0; font-size: 1rem }
    .bar { margin-top: 0.4rem }
  }
  .bar { display: flex; align-items: center; gap: 0.75rem; margin-top: 0.9rem }
  .toggle { display: grid; place-items: center; width: 44px; height: 44px; flex: none; border: 0; border-radius: 50%; background-color: var(--saffron); color: var(--saffron-ink); cursor: pointer }
  .toggle .pause, .toggle[data-playing='true'] .play { display: none }
  .toggle[data-playing='true'] .pause { display: block }
  .dots { display: flex; gap: 0.35rem; list-style: none; margin: 0; padding: 0; flex: 1 }
  .dots li { flex: 1 }
  .dots button { display: block; width: 100%; height: 44px; border: 0; background: none; cursor: pointer; padding: 0; position: relative }
  .dots button::after { content: ''; position: absolute; inset: 19px 0; border-radius: 3px; background-color: var(--line) }
  .dots button[aria-current='true']::after { background-color: var(--saffron) }
  figcaption p { margin: 0.6rem 0 0; font-size: 1.1rem; font-weight: 600; min-height: 3.3em }
</style>
