---
// One screen of the tour: a phone screenshot beside its title and one plain sentence.
import { Image } from 'astro:assets'
import type { ImageMetadata } from 'astro'
interface Props { src: ImageMetadata; title: string; caption: string; n: number; of: number }
const { src, title, caption, n, of } = Astro.props
---
<li class="card" data-card="screen" aria-label={`${n} of ${of}: ${title}`}>
  <div class="phone"><Image src={src} alt={`${title}: ${caption}`} widths={[300, 390]} sizes="300px" /></div>
  <div class="words">
    <h2>{title}</h2>
    <p>{caption}</p>
  </div>
</li>

<style>
  .card { display: grid; gap: 1.25rem; justify-items: center; align-content: start }
  .phone { padding: 7px; border-radius: 30px; background-color: #2b2d33; box-shadow: var(--shadow) }
  .phone :global(img) { display: block; height: min(48svh, 560px); width: auto; max-width: 78vw; object-fit: cover; object-position: top; border-radius: 23px }
  .words { text-align: center; max-width: 30rem; order: -1 }
  h2 { font-size: 1.5rem; margin-bottom: 0.25em }
  p { margin: 0 auto; color: var(--muted) }
  @media (min-width: 900px) {
    .card { grid-template-columns: auto 1fr; justify-items: start; align-items: center; gap: 3rem }
    .words { text-align: left; order: 0 }
    h2 { font-size: 2.2rem }
  }
</style>
