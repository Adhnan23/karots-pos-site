<div class="prose"><slot /></div>

<style>
  .prose { max-width: 46rem }
  .prose :global(h2) { font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2rem); margin-top: 2.5em; scroll-margin-top: 5rem }
  .prose :global(h3) { margin-top: 2em }
  .prose :global(ul), .prose :global(ol) { padding-left: 1.2em; margin: 0 0 1.2em }
  .prose :global(li) { margin-bottom: 0.45em; padding-left: 0.2em }
  .prose :global(li::marker) { color: var(--saffron) }
  .prose :global(strong) { font-weight: 700 }
  .prose :global(code) { font-size: 0.9em; padding: 0.1em 0.35em; border-radius: 6px; background-color: var(--surface); border: 1px solid var(--line) }
  .prose :global(a) { text-decoration-color: var(--saffron); text-decoration-thickness: 2px }
  .prose :global(p:has(> img)) { max-width: none; margin: 1.75rem 0 }
  .prose :global(img) {
    border-radius: var(--r-frame); border: 1px solid var(--line); box-shadow: var(--shadow);
    background-color: var(--surface);
  }
  .prose :global(table) { border-collapse: collapse; width: 100%; margin: 0 0 1.5em; font-size: 0.95rem; display: block; overflow-x: auto }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 0.55rem 0.75rem; border-bottom: 1px solid var(--line); vertical-align: top }
  .prose :global(th) { font-weight: 700 }
  .prose :global(blockquote) { margin: 0 0 1.2em; padding: 0.75rem 1rem; border-left: 4px solid var(--saffron); background-color: var(--surface); border-radius: 0 var(--r-btn) var(--r-btn) 0 }
  .prose :global(blockquote p) { margin: 0 }
</style>
<style>
  /* Several screenshots in one paragraph sit side by side (light / dark, phone screens). */
  .prose :global(p:has(> img + img)) { display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: flex-start }
  .prose :global(p:has(> img + img) > img) { flex: 1 1 140px; min-width: 0 }
</style>
