---
import Button from './Button.astro'
import Receipt from './Receipt.astro'
import { CONTACT } from '../data/site'
---
<section class="hero">
  <div class="wrap grid">
    <div class="copy">
      <h1>Sell, count and order, all from one counter.</h1>
      <p class="lede">
        Karots Suite runs your till, stock, suppliers and money for a small Sri Lankan shop. It lives on your own PC and
        keeps selling when the internet or the power goes.
      </p>
      <div class="actions">
        <Button href="/tour/" id="demo-button" data-demo data-pc="Book a demo at your shop" data-live="Try the live demo">See it on this phone</Button>
        <Button href={`tel:${CONTACT.phone}`} kind="ghost">Call {CONTACT.phoneDisplay}</Button>
      </div>
    </div>
    <Receipt />
  </div>
</section>

<style>
  .hero { padding-block: clamp(2.5rem, 7vw, 6rem) clamp(3rem, 8vw, 6rem) }
  .grid { display: grid; gap: 3rem; align-items: center }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem }
  @media (min-width: 900px) { .grid { grid-template-columns: 1.35fr 1fr } }
</style>

<script>
  import { wireDemoButtons } from '../scripts/demo-button'
  wireDemoButtons()
</script>
