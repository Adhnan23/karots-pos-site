---
// The hero: real receipts the Suite printed in the Demo Room (make tour-shots → tour/<kind>/receipt.png),
// each in its shop's own receipt style. One slides out of the printer on load; "Print another" prints the next.
import { Image } from 'astro:assets'
import { shot } from '../lib/shots'

const slips = [
  { kind: 'hardware', shop: 'Lanka Build Hardware' },
  { kind: 'pharmacy', shop: 'CityCare Pharmacy' },
  { kind: 'phone', shop: 'Galaxy Mobile & Repairs' },
  { kind: 'grocery', shop: 'Sunrise Mini Mart' },
].map((s) => ({ ...s, src: shot(`tour/${s.kind}/receipt.png`) }))
---
<figure class="receipt" data-receipt>
  <div class="printer" aria-hidden="true"><span></span></div>
  <div class="out">
    {slips.map((s, i) => (
      <Image data-slip data-shop={s.shop} class:list={['paper', { on: i === 0 }]} src={s.src}
        alt={`A receipt printed by Karots Suite for ${s.shop}, in its own style`} widths={[340, 680]} sizes="340px"
        quality={90} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} />
    ))}
  </div>
  <figcaption>
    <span data-caption>{slips[0].shop}’s receipt</span>
    <button type="button" data-print>Print another</button>
  </figcaption>
</figure>

<script>
  for (const fig of document.querySelectorAll<HTMLElement>('[data-receipt]')) {
    const slips = [...fig.querySelectorAll<HTMLImageElement>('[data-slip]')]
    const caption = fig.querySelector('[data-caption]')!
    let i = 0
    fig.querySelector('[data-print]')!.addEventListener('click', () => {
      slips[i].classList.remove('on')
      i = (i + 1) % slips.length
      slips[i].loading = 'eager'
      void slips[i].offsetWidth // restart the feed animation
      slips[i].classList.add('on')
      caption.textContent = `${slips[i].dataset.shop}’s receipt`
    })
  }
</script>

<style>
  .receipt { margin: 0; width: min(100%, 340px); justify-self: center; display: grid }
  .printer {
    height: 18px; margin-inline: -16px; position: relative; z-index: 1; border-radius: 9px;
    background-color: #2b2d33; box-shadow: var(--shadow);
  }
  .printer span { position: absolute; left: 12px; right: 12px; top: 8px; height: 3px; border-radius: 2px; background-color: #0d0e11 }
  .out { overflow: hidden; margin-top: -9px; padding: 0 8px 24px } /* room for the paper's shadow */
  .out :global(.paper) {
    display: none; width: 100%; height: auto; background-color: #fff; padding: 18px 14px 26px;
    box-shadow: 0 10px 28px -12px rgb(22 23 27 / 0.45);
    mask: conic-gradient(from -45deg at bottom, #0000, #000 1deg 89deg, #0000 90deg) bottom / 14px 100%;
  }
  .out :global(.paper.on) { display: block; animation: feed 1.9s cubic-bezier(0.22, 0.7, 0.25, 1) both }
  @keyframes feed { from { transform: translateY(-100%) } to { transform: translateY(0) } }
  figcaption { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.25rem; color: var(--muted); font-size: 0.95rem }
  button {
    flex: none; min-height: 44px; padding: 0 1rem; border-radius: var(--r-btn); border: 2px solid var(--line);
    background: none; color: var(--ink); font: inherit; font-weight: 700; cursor: pointer;
  }
  button:hover { border-color: var(--saffron) }
</style>
